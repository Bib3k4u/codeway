# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/codeway
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ---- AI (OpenAI-compatible). Leave blank to run with seed challenges only ----
AI_ENDPOINT=
AI_API_KEY=
# Azure OpenAI: set the api-version (e.g. 2024-10-21). Plain OpenAI: leave empty.
AI_API_VERSION=
# Azure deployment name, or OpenAI model id (e.g. gpt-4.1)
AI_MODEL=
# Cheaper model for hints (defaults to AI_MODEL)
AI_HINT_MODEL=
# Daily caps on AI calls (UTC day), per user and for the whole app; 0 = no cap
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=300

# Sign-in is GitHub through Supabase Auth; the backend verifies tokens with the project's public keys
SUPABASE_URL=https://uranrdbdvboeqqimmfgb.supabase.co

# ---- Runner ----
RUNNER_MODE=local
