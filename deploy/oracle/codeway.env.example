# /opt/codeway/codeway.env on the Oracle server (permissions 600, owned by codeway). Plain KEY=VALUE lines, no quotes.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Postgres. Neon: the postgresql://user:pass@host/db?sslmode=require string works as-is. Self-hosted: postgres.sh sets these.
DB_URL=
DB_USER=
DB_PASSWORD=

# Azure AI Foundry (same values as your local .env)
AI_ENDPOINT=
AI_API_KEY=
AI_API_VERSION=
AI_MODEL=
AI_HINT_MODEL=
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=300

# Sign-in is GitHub through Supabase Auth; the backend verifies tokens with the project's public keys
SUPABASE_URL=https://uranrdbdvboeqqimmfgb.supabase.co

# Learner code runs in a throwaway Docker container per run. 2 OCPUs: two runs at a time.
RUNNER_MODE=docker
RUNNER_MAX_CONCURRENT=2
RUNNER_MEMORY=512m

# Only matters for browsers calling the API directly; the Next.js frontend proxies /api server-side.
CORS_ORIGINS=http://localhost:*,https://codeway-three.vercel.app
